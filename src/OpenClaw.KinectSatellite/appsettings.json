{
  "Kinect": {
    "EchoCancellation": true,
    "NoiseSuppression": true,
    "FrameMilliseconds": 30
  },
  "WakeWord": {
    "ModelPath": "models/okay-nabu.onnx",
    "Threshold": 0.7,
    "TriggerFrames": 3,
    "CooldownSeconds": 2
  },
  "HomeAssistant": {
    "Url": "http://homeassistant.local:8123",
    "AccessToken": "SET_WITH_Environment__HomeAssistant__AccessToken",
    "PipelineId": null,
    "DeviceId": null
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning" } }
  }
}

