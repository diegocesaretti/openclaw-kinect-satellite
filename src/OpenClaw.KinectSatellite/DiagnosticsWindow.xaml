<Window x:Class="OpenClaw.KinectSatellite.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClaw Diagnostics" Height="680" Width="920"
        MinHeight="480" MinWidth="700" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top"
                   Text="Technical diagnostics — copy this report when asking for help."
                   FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Refresh" Click="Refresh_Click" Padding="16,7" Margin="0,0,8,0"/>
            <Button Content="Copy all" Click="Copy_Click" Padding="16,7" Margin="0,0,8,0"/>
            <Button Content="Open logs folder" Click="OpenLogs_Click" Padding="16,7" Margin="0,0,8,0"/>
            <Button Content="Close" Click="Close_Click" Padding="16,7" IsCancel="True"/>
        </StackPanel>
        <TextBox x:Name="DiagnosticsText"
                 IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 Padding="10"/>
    </DockPanel>
</Window>
