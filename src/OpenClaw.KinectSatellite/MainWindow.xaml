<Window x:Class="OpenClaw.KinectSatellite.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="OpenClaw Kinect Satellite" Height="720" Width="680" MinHeight="650" MinWidth="620" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="18">
  <Border DockPanel.Dock="Top" Background="#18212B" CornerRadius="8" Padding="16" Margin="0,0,0,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="OpenClaw Kinect Satellite" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock x:Name="StatusText" Text="Stopped" Foreground="#B8C7D9" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="StartButton" Content="Start" Click="Start_Click" Padding="18,7" Margin="0,0,8,0"/>
     <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Padding="18,7" Margin="0,0,8,0" IsEnabled="False"/>
     <Button Content="Diagnostics" Click="Diagnostics_Click" Padding="18,7"/>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Margin="2,10,2,8" Foreground="#B00020"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Test connection" Click="TestConnection_Click" Padding="15,7" Margin="0,0,8,0"/>
    <Button Content="Apply and save" Click="Save_Click" Padding="15,7" IsDefault="True"/>
   </StackPanel>
  </StackPanel>
  <TabControl>
   <TabItem Header="Home Assistant"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="URL" VerticalAlignment="Center"/><TextBox x:Name="HaUrl" Grid.Column="1" Margin="0,6" Padding="6"/>
    <TextBlock Grid.Row="1" Text="Access token" VerticalAlignment="Center"/><PasswordBox x:Name="HaToken" Grid.Row="1" Grid.Column="1" Margin="0,6" Padding="6"/>
    <TextBlock Grid.Row="2" Text="Pipeline ID (optional)" VerticalAlignment="Center"/><TextBox x:Name="PipelineId" Grid.Row="2" Grid.Column="1" Margin="0,6" Padding="6"/>
    <TextBlock Grid.Row="3" Text="Device ID (optional)" VerticalAlignment="Center"/><TextBox x:Name="DeviceId" Grid.Row="3" Grid.Column="1" Margin="0,6" Padding="6"/>
   </Grid></TabItem>
   <TabItem Header="Wake word"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Wake word" VerticalAlignment="Center"/><ComboBox x:Name="WakeWord" Grid.Column="1" Margin="0,6" Padding="6" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="WakeWord_SelectionChanged"/>
    <TextBlock Grid.Row="1" Text="Threshold (0–1)"/><TextBox x:Name="Threshold" Grid.Row="1" Grid.Column="1" Margin="0,6" Padding="6"/>
    <TextBlock Grid.Row="2" Text="Trigger frames (1–20)"/><TextBox x:Name="TriggerFrames" Grid.Row="2" Grid.Column="1" Margin="0,6" Padding="6"/>
    <TextBlock Grid.Row="3" Text="Cooldown seconds (0–30)"/><TextBox x:Name="Cooldown" Grid.Row="3" Grid.Column="1" Margin="0,6" Padding="6"/>
    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Uses official openWakeWord ONNX models downloaded and SHA-256 verified on first start. Pre-trained models are CC BY-NC-SA 4.0: attribution, ShareAlike and non-commercial use terms apply." TextWrapping="Wrap" Foreground="#52616F" Margin="0,10,0,0"/>
   </Grid></TabItem>
   <TabItem Header="Kinect &amp; app"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <CheckBox x:Name="EchoCancellation" Content="Echo cancellation" Grid.ColumnSpan="2" Margin="0,8"/>
    <CheckBox x:Name="NoiseSuppression" Content="Noise suppression" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8"/>
    <TextBlock Grid.Row="2" Text="Logging level" VerticalAlignment="Center"/><ComboBox x:Name="LoggingLevel" Grid.Row="2" Grid.Column="1" Margin="0,6" Padding="5"><ComboBoxItem>Debug</ComboBoxItem><ComboBoxItem>Information</ComboBoxItem><ComboBoxItem>Warning</ComboBoxItem><ComboBoxItem>Error</ComboBoxItem></ComboBox>
    <CheckBox x:Name="LaunchAtStartup" Content="Launch at Windows sign-in" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8"/>
   </Grid></TabItem>
  </TabControl>
 </DockPanel>
</Window>
